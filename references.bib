@article{romp_political_2024,
	title = {The political process and phase‐in period of pension reforms},
	abstract = {We construct a novel database of pension reforms in 23 countries from 1970 to 2023. Based on a narrative identification and automated text filters we identify 1,828 legislated reform packages and determine whether those reforms improve or worsen the financial position of the current participants and the length of the phase‐in periods. The research contributes to understanding the political economy of pension reforms and their implementation timelines. Reforms making pension systems less generous have longer phase‐in periods, but there is no significant relation between demographic conditions and length of the phase‐in period.},
	language = {en},
    journal = {Netspar},
